{
  "name": "od-block-css-indicator",
  "version": "0.1.1",
  "private": true,
  "engines": {
    "node": ">=24.18.0",
    "npm": ">=11.16.0"
  },
  "scripts": {
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "env:status": "wp-env status",
    "env:logs": "wp-env logs",
    "env:cli": "wp-env run cli wp",
    "composer": "wp-env run cli --env-cwd=wp-content/plugins/od-block-css-indicator composer",
    "lint:php": "npm run composer -- lint",
    "i18n:pot": "wp-env run cli --env-cwd=wp-content/plugins/od-block-css-indicator wp i18n make-pot . languages/od-block-css-indicator.pot --domain=od-block-css-indicator --exclude=vendor,node_modules,dist",
    "i18n:mo": "wp-env run cli --env-cwd=wp-content/plugins/od-block-css-indicator wp i18n make-mo languages",
    "package": "python3 scripts/package.py",
    "build": "wp-scripts build",
    "start": "wp-scripts start",
    "lint:js": "wp-scripts lint-js src",
    "lint:css": "wp-scripts lint-style \"src/**/*.scss\"",
    "test:unit": "wp-scripts test-unit-js --runInBand",
    "test:e2e": "playwright test",
    "test:integration": "wp-env run cli wp eval-file wp-content/plugins/od-block-css-indicator/tests/integration.php",
    "i18n:json": "wp-env run cli --env-cwd=wp-content/plugins/od-block-css-indicator wp i18n make-json languages --no-purge",
    "test:non-interference": "python3 tests/non-interference.py"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@wordpress/env": "^12.1.0",
    "@wordpress/scripts": "^35.0.0"
  },
  "dependencies": {
    "@wordpress/api-fetch": "^8.1.0",
    "@wordpress/block-editor": "^20.0.0",
    "@wordpress/blocks": "^17.1.0",
    "@wordpress/components": "^44.0.0",
    "@wordpress/compose": "^9.1.0",
    "@wordpress/data": "^11.1.0",
    "@wordpress/editor": "^16.1.0",
    "@wordpress/element": "^10.1.0",
    "@wordpress/hooks": "^5.1.0",
    "@wordpress/i18n": "^7.1.0",
    "@wordpress/plugins": "^8.1.0"
  }
}
